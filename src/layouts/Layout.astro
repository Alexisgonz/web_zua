---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@300;400;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="font-nunito text-gray-800">
    <header class="fixed top-0 inset-x-0 z-50">
      <div
        id="bar"
        class="w-full bg-white/90 backdrop-blur-md transition-all duration-300"
      >
        <nav
          id="nav"
          class="max-w-7xl mx-auto h-16 md:h-20 lg:h-24 px-4 md:px-6 lg:px-0
         flex items-center justify-between transition-all duration-300"
        >
          <a href="/" class="h-full flex items-center shrink-0">
            <img
              id="logo"
              src="/Logo_sua.png"
              alt="SUA"
              class="block w-auto h-12 md:h-16 lg:h-18 xl:h-20"
              loading="eager"
              decoding="async"
            />
          </a>

          <!-- Mobile menu button -->
          <button 
            id="mobile-menu-button"
            class="md:hidden flex flex-col items-center justify-center w-8 h-8 space-y-1"
            aria-label="Abrir menú"
          >
            <span class="w-6 h-0.5 bg-gray-800 transition-all duration-300"></span>
            <span class="w-6 h-0.5 bg-gray-800 transition-all duration-300"></span>
            <span class="w-6 h-0.5 bg-gray-800 transition-all duration-300"></span>
          </button>

          <!-- Desktop Navigation -->
          <ul class="hidden md:flex gap-6 lg:gap-8">
            <li>
              <a
                href="#inicio"
                class="font-semibold text-sm lg:text-base text-gray-800 hover:text-forest transition-colors"
                >Inicio</a>
            </li>
            <li>
              <a
                href="#chocizone"
                class="font-semibold text-sm lg:text-base text-gray-800 hover:text-forest transition-colors"
                >Chocizone</a>
            </li>
            <li>
              <a
                href="#fihizo"
                class="font-semibold text-sm lg:text-base text-gray-800 hover:text-forest transition-colors"
                >Fihizo</a>
            </li>
            <!-- <li>
              <a
                href="#sostenibilidad"
                class="font-semibold text-sm lg:text-base text-gray-800 hover:text-forest transition-colors"
                >Sostenibilidad</a>
            </li> -->
            <!-- <li>
              <a
                href="#contacto"
                class="font-semibold text-sm lg:text-base text-gray-800 hover:text-forest transition-colors"
                >Contacto</a>
            </li> -->
          </ul>

          <!-- Mobile Navigation Menu -->
          <div 
            id="mobile-menu" 
            class="md:hidden fixed inset-0 top-16 bg-white/95 backdrop-blur-md transform translate-x-full transition-transform duration-300 ease-in-out"
          >
            <ul class="flex flex-col items-center justify-center h-full space-y-8">
              <li>
                <a
                  href="#inicio"
                  class="mobile-nav-link font-semibold text-xl text-gray-800 hover:text-forest transition-colors"
                  >Inicio</a>
              </li>
              <li>
                <a
                  href="#nosotros"
                  class="mobile-nav-link font-semibold text-xl text-gray-800 hover:text-forest transition-colors"
                  >Nosotros</a>
              </li>
              <li>
                <a
                  href="#productos"
                  class="mobile-nav-link font-semibold text-xl text-gray-800 hover:text-forest transition-colors"
                  >Productos</a>
              </li>
              <li>
                <a
                  href="#sostenibilidad"
                  class="mobile-nav-link font-semibold text-xl text-gray-800 hover:text-forest transition-colors"
                  >Sostenibilidad</a>
              </li>
              <li>
                <a
                  href="#contacto"
                  class="mobile-nav-link font-semibold text-xl text-gray-800 hover:text-forest transition-colors"
                  >Contacto</a>
              </li>
            </ul>
          </div>
        </nav>
      </div>
    </header>

    <main class="mt-16 md:mt-20 lg:mt-24">
      <slot />
    </main>

    <footer class="bg-forest text-white px-4 md:px-8 py-12 md:py-16">
      <div
        class="max-w-7xl mx-auto grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8 md:gap-12 mb-8"
      >
        <div class="col-span-1 sm:col-span-2 md:col-span-1">
          <h4 class="text-xl md:text-2xl font-extrabold mb-4 md:mb-6">SUA</h4>
          <p class="text-white/80 leading-relaxed text-sm md:text-base">
            Transformadores de cacao con propósito. Del bosque colombiano al
            mundo, con sostenibilidad, calidad y compromiso con el bienestar.
          </p>
        </div>
        <div>
          <h4 class="text-lg md:text-xl font-extrabold mb-4 md:mb-6">Empresa</h4>
          <a href="#nosotros" class="block text-white/80 hover:text-white mb-2 text-sm md:text-base"
            >Sobre Nosotros</a
          >
          <a href="#productos" class="block text-white/80 hover:text-white mb-2 text-sm md:text-base"
            >Productos</a
          >
          <a href="#" class="block text-white/80 hover:text-white mb-2 text-sm md:text-base"
            >Sostenibilidad</a
          >
          <a href="#" class="block text-white/80 hover:text-white mb-2 text-sm md:text-base">Blog</a>
        </div>
        <div>
          <h4 class="text-lg md:text-xl font-extrabold mb-4 md:mb-6">Soporte</h4>
          <a href="#" class="block text-white/80 hover:text-white mb-2 text-sm md:text-base"
            >Contacto</a
          >
          <a href="#" class="block text-white/80 hover:text-white mb-2 text-sm md:text-base"
            >Preguntas Frecuentes</a
          >
          <a href="#" class="block text-white/80 hover:text-white mb-2 text-sm md:text-base"
            >Certificaciones</a
          >
          <a href="#" class="block text-white/80 hover:text-white mb-2 text-sm md:text-base"
            >Distribuidores</a
          >
        </div>
        <div>
          <h4 class="text-lg md:text-xl font-extrabold mb-4 md:mb-6">Contacto</h4>
          <p class="text-white/80 mb-2 text-sm md:text-base">Email: contacto@sua.co</p>
          <p class="text-white/80 mb-2 text-sm md:text-base">Teléfono: +57 (XXX) XXX-XXXX</p>
          <p class="text-white/80 text-sm md:text-base">Colombia</p>
        </div>
      </div>
      <div class="text-center pt-6 md:pt-8 border-t border-white/20">
        <p class="text-white/70 text-sm md:text-base">
          &copy; 2025 SUA - Todos los derechos reservados
        </p>
      </div>
    </footer>
  </body>
</html>

<script is:inline>
  const bar = document.getElementById("bar");
  const mobileMenuButton = document.getElementById("mobile-menu-button");
  const mobileMenu = document.getElementById("mobile-menu");
  const mobileNavLinks = document.querySelectorAll(".mobile-nav-link");

  let isMenuOpen = false;

  function toggleMobileMenu() {
    isMenuOpen = !isMenuOpen;
    
    if (isMenuOpen) {
      mobileMenu.style.transform = "translateX(0)";
      mobileMenuButton.children[0].style.transform = "rotate(45deg) translate(5px, 5px)";
      mobileMenuButton.children[1].style.opacity = "0";
      mobileMenuButton.children[2].style.transform = "rotate(-45deg) translate(7px, -6px)";
      document.body.style.overflow = "hidden";
    } else {
      mobileMenu.style.transform = "translateX(100%)";
      mobileMenuButton.children[0].style.transform = "rotate(0) translate(0, 0)";
      mobileMenuButton.children[1].style.opacity = "1";
      mobileMenuButton.children[2].style.transform = "rotate(0) translate(0, 0)";
      document.body.style.overflow = "";
    }
  }

  function closeMobileMenu() {
    if (isMenuOpen) {
      toggleMobileMenu();
    }
  }

  function update() {
    const scrolled = window.scrollY > 10;

    if (scrolled) {
      // Comportamiento como Compensave: header más estrecho y centrado con scroll
      bar.style.maxWidth = "78%";
      bar.style.margin = "0 auto";
      bar.classList.add("rounded-b-2xl");
    } else {
      bar.style.maxWidth = "";
      bar.style.margin = "";
      bar.classList.remove("rounded-b-2xl");
    }
  }

  // Event listeners
  mobileMenuButton.addEventListener("click", toggleMobileMenu);
  
  // Close menu when clicking on nav links
  mobileNavLinks.forEach(link => {
    link.addEventListener("click", closeMobileMenu);
  });

  // Close menu when clicking outside
  mobileMenu.addEventListener("click", (e) => {
    if (e.target === mobileMenu) {
      closeMobileMenu();
    }
  });

  update();
  window.addEventListener("scroll", update, { passive: true });
  window.addEventListener("resize", update);
</script>

<style is:global>
  @import "../styles/global.css";
</style>
