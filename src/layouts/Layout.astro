---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@300;400;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="font-nunito text-gray-800">
    <!-- Header con efecto Orizon -->
    <header class="fixed top-0 left-0 right-0 z-50 px-4 md:px-6 lg:px-8 pt-4 md:pt-6 pb-0">
      <div
        id="header-bar"
        class="max-w-7xl mx-auto bg-white/95 backdrop-blur-lg rounded-2xl shadow-lg transition-all duration-500 ease-out"
      >
        <nav class="px-4 md:px-6 lg:px-8 h-16 md:h-18 flex items-center justify-between">
          <!-- Logo -->
          <a href="/" class="flex items-center shrink-0 group">
            <img
              src="/Logo_sua.png"
              alt="SUA"
              class="w-auto h-10 md:h-12 lg:h-14 transition-transform duration-300 group-hover:scale-105"
              loading="eager"
              decoding="async"
            />
          </a>

          <!-- Desktop Navigation -->
          <ul class="hidden md:flex items-center gap-8 lg:gap-10">
            <li>
              <a
                href="#inicio"
                class="relative font-semibold text-sm lg:text-base text-gray-700 hover:text-forest transition-colors duration-300 after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-0.5 after:bg-forest after:transition-all after:duration-300 hover:after:w-full"
              >
                Inicio
              </a>
            </li>
            <li>
              <a
                href="#nosotros"
                class="relative font-semibold text-sm lg:text-base text-gray-700 hover:text-forest transition-colors duration-300 after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-0.5 after:bg-forest after:transition-all after:duration-300 hover:after:w-full"
              >
                Chocizone
              </a>
            </li>
            <li>
              <a
                href="#productos"
                class="relative font-semibold text-sm lg:text-base text-gray-700 hover:text-forest transition-colors duration-300 after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-0.5 after:bg-forest after:transition-all after:duration-300 hover:after:w-full"
              >
                Fihizu
              </a>
            </li>
          </ul>

          <!-- Mobile Menu Button -->
          <button
            id="mobile-menu-button"
            class="md:hidden relative w-10 h-10 flex items-center justify-center rounded-lg hover:bg-gray-100 transition-colors"
            aria-label="Abrir menú"
          >
            <div class="w-5 h-4 flex flex-col justify-between">
              <span class="w-full h-0.5 bg-gray-800 rounded-full transition-all duration-300 origin-center"></span>
              <span class="w-full h-0.5 bg-gray-800 rounded-full transition-all duration-300"></span>
              <span class="w-full h-0.5 bg-gray-800 rounded-full transition-all duration-300 origin-center"></span>
            </div>
          </button>
        </nav>
      </div>

      <!-- Mobile Menu Overlay -->
      <div
        id="mobile-menu-overlay"
        class="md:hidden fixed inset-0 bg-black/0 backdrop-blur-0 opacity-0 pointer-events-none transition-all duration-300 z-40"
      ></div>

      <!-- Mobile Menu -->
      <div
        id="mobile-menu"
        class="md:hidden fixed top-24 left-4 right-4 bg-white rounded-2xl shadow-2xl overflow-hidden transform scale-95 opacity-0 pointer-events-none transition-all duration-300 z-50"
      >
        <nav class="p-6">
          <ul class="space-y-1">
            <li>
              <a
                href="#inicio"
                class="mobile-nav-link block px-4 py-3 text-base font-semibold text-gray-700 hover:text-forest hover:bg-gray-50 rounded-lg transition-all"
              >
                Inicio
              </a>
            </li>
            <li>
              <a
                href="#nosotros"
                class="mobile-nav-link block px-4 py-3 text-base font-semibold text-gray-700 hover:text-forest hover:bg-gray-50 rounded-lg transition-all"
              >
                Nosotros
              </a>
            </li>
            <li>
              <a
                href="#productos"
                class="mobile-nav-link block px-4 py-3 text-base font-semibold text-gray-700 hover:text-forest hover:bg-gray-50 rounded-lg transition-all"
              >
                Productos
              </a>
            </li>
            <li>
              <a
                href="#sostenibilidad"
                class="mobile-nav-link block px-4 py-3 text-base font-semibold text-gray-700 hover:text-forest hover:bg-gray-50 rounded-lg transition-all"
              >
                Sostenibilidad
              </a>
            </li>
            <li class="pt-2">
              <a
                href="#contacto"
                class="mobile-nav-link block px-4 py-3 text-base font-bold text-white bg-forest hover:bg-forest-light rounded-lg text-center transition-all"
              >
                Contacto
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="bg-forest text-white px-4 md:px-8 py-12 md:py-16">
      <div
        class="max-w-7xl mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 md:gap-12 mb-8"
      >
        <div class="col-span-1 sm:col-span-2 lg:col-span-1">
          <h4 class="text-xl md:text-2xl font-extrabold mb-4 md:mb-6">SUA</h4>
          <p class="text-white/80 leading-relaxed text-sm md:text-base">
            Transformadores de cacao con propósito. Del bosque colombiano al
            mundo, con sostenibilidad, calidad y compromiso con el bienestar.
          </p>
        </div>
        <div>
          <h4 class="text-lg md:text-xl font-extrabold mb-4 md:mb-6">Empresa</h4>
          <a href="#nosotros" class="block text-white/80 hover:text-white mb-2 text-sm md:text-base transition-colors">
            Sobre Nosotros
          </a>
          <a href="#productos" class="block text-white/80 hover:text-white mb-2 text-sm md:text-base transition-colors">
            Productos
          </a>
          <a href="#" class="block text-white/80 hover:text-white mb-2 text-sm md:text-base transition-colors">
            Sostenibilidad
          </a>
          <a href="#" class="block text-white/80 hover:text-white mb-2 text-sm md:text-base transition-colors">Blog</a>
        </div>
        <div>
          <h4 class="text-lg md:text-xl font-extrabold mb-4 md:mb-6">Soporte</h4>
          <a href="#" class="block text-white/80 hover:text-white mb-2 text-sm md:text-base transition-colors">
            Contacto
          </a>
          <a href="#" class="block text-white/80 hover:text-white mb-2 text-sm md:text-base transition-colors">
            Preguntas Frecuentes
          </a>
          <a href="#" class="block text-white/80 hover:text-white mb-2 text-sm md:text-base transition-colors">
            Certificaciones
          </a>
          <a href="#" class="block text-white/80 hover:text-white mb-2 text-sm md:text-base transition-colors">
            Distribuidores
          </a>
        </div>
        <div>
          <h4 class="text-lg md:text-xl font-extrabold mb-4 md:mb-6">Contacto</h4>
          <p class="text-white/80 mb-2 text-sm md:text-base">Email: contacto@sua.co</p>
          <p class="text-white/80 mb-2 text-sm md:text-base">Teléfono: +57 (XXX) XXX-XXXX</p>
          <p class="text-white/80 text-sm md:text-base">Colombia</p>
        </div>
      </div>
      <div class="text-center pt-6 md:pt-8 border-t border-white/20">
        <p class="text-white/70 text-sm md:text-base">
          &copy; 2025 SUA - Todos los derechos reservados
        </p>
      </div>
    </footer>
  </body>
</html>

<script is:inline>
  const headerBar = document.getElementById("header-bar");
  const mobileMenuButton = document.getElementById("mobile-menu-button");
  const mobileMenu = document.getElementById("mobile-menu");
  const mobileMenuOverlay = document.getElementById("mobile-menu-overlay");
  const mobileNavLinks = document.querySelectorAll(".mobile-nav-link");

  let isMenuOpen = false;
  let lastScrollY = window.scrollY;

  // Toggle Mobile Menu
  function toggleMobileMenu() {
    isMenuOpen = !isMenuOpen;
    
    if (isMenuOpen) {
      // Open menu
      mobileMenu.classList.remove("pointer-events-none", "opacity-0", "scale-95");
      mobileMenu.classList.add("opacity-100", "scale-100");
      
      mobileMenuOverlay.classList.remove("pointer-events-none", "opacity-0", "backdrop-blur-0", "bg-black/0");
      mobileMenuOverlay.classList.add("opacity-100", "backdrop-blur-sm", "bg-black/20");
      
      // Animate hamburger to X
      const spans = mobileMenuButton.querySelectorAll("span");
      spans[0].style.transform = "rotate(45deg) translateY(7px)";
      spans[1].style.opacity = "0";
      spans[2].style.transform = "rotate(-45deg) translateY(-7px)";
      
      document.body.style.overflow = "hidden";
    } else {
      // Close menu
      mobileMenu.classList.add("opacity-0", "scale-95");
      mobileMenu.classList.remove("opacity-100", "scale-100");
      
      setTimeout(() => {
        mobileMenu.classList.add("pointer-events-none");
      }, 300);
      
      mobileMenuOverlay.classList.add("opacity-0", "backdrop-blur-0", "bg-black/0");
      mobileMenuOverlay.classList.remove("opacity-100", "backdrop-blur-sm", "bg-black/20");
      
      setTimeout(() => {
        mobileMenuOverlay.classList.add("pointer-events-none");
      }, 300);
      
      // Reset hamburger
      const spans = mobileMenuButton.querySelectorAll("span");
      spans[0].style.transform = "";
      spans[1].style.opacity = "";
      spans[2].style.transform = "";
      
      document.body.style.overflow = "";
    }
  }

  function closeMobileMenu() {
    if (isMenuOpen) {
      toggleMobileMenu();
    }
  }

  // Header scroll effect - Estilo Orizon
  function updateHeader() {
    const scrollY = window.scrollY;
    
    if (scrollY > 20) {
      // Scrolled: más compacto y sombra más pronunciada
      headerBar.style.padding = "0.5rem 1rem";
      headerBar.classList.add("shadow-xl");
      headerBar.classList.remove("shadow-lg");
    } else {
      // Top: más espacioso
      headerBar.style.padding = "";
      headerBar.classList.remove("shadow-xl");
      headerBar.classList.add("shadow-lg");
    }
    
    lastScrollY = scrollY;
  }

  // Event Listeners
  mobileMenuButton.addEventListener("click", toggleMobileMenu);
  mobileMenuOverlay.addEventListener("click", closeMobileMenu);
  
  mobileNavLinks.forEach(link => {
    link.addEventListener("click", closeMobileMenu);
  });

  // Smooth scroll for anchor links
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener("click", function (e) {
      const href = this.getAttribute("href");
      if (href !== "#" && href !== "") {
        e.preventDefault();
        const target = document.querySelector(href);
        if (target) {
          const headerHeight = 100; // Adjust for fixed header
          const targetPosition = target.offsetTop - headerHeight;
          
          window.scrollTo({
            top: targetPosition,
            behavior: "smooth"
          });
        }
      }
    });
  });

  // Initialize
  updateHeader();
  window.addEventListener("scroll", updateHeader, { passive: true });
  window.addEventListener("resize", updateHeader);
</script>

<style is:global>
  @import "../styles/global.css";
  
  /* Smooth scrolling */
  html {
    scroll-behavior: smooth;
  }
  
  /* Custom scrollbar */
  ::-webkit-scrollbar {
    width: 10px;
  }
  
  ::-webkit-scrollbar-track {
    background: #f1f1f1;
  }
  
  ::-webkit-scrollbar-thumb {
    background: #1a4d2e;
    border-radius: 5px;
  }
  
  ::-webkit-scrollbar-thumb:hover {
    background: #2d5f3f;
  }
</style>