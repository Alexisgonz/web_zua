---
interface Colors {
  from: string;
  to: string;
  gradient: string;
  gradientTo: string;
  accent: string;
}

interface CTA {
  text: string;
  href: string;
}

interface BrandItem {
  id: string;
  name: string;
  icon: string;
  category: string;
  description: string;
  products: string[];
  cta: CTA;
  colors: Colors;
}

interface Section {
  id: string;
  label: string;
  title: string;
  titleHighlight: string;
}

interface BrandsData {
  section: Section;
  items: BrandItem[];
}

interface Props {
  data: BrandsData;
}

const { data } = Astro.props as Props;
const { section, items } = data;
---

<section id={section.id} class="py-20 md:py-24 px-4 md:px-6 lg:px-8 bg-gradient-to-br from-gray-50 via-gray-100 to-gray-200">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-title-green">
        {section.title}<br/>
        <span class="text-title-green">{section.titleHighlight}</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
      {items.map((brand: BrandItem) => (
        <div class="group relative bg-gradient-to-br from-white to-gray-100 rounded-3xl overflow-hidden shadow-xl hover:shadow-2xl transition-all duration-500 border border-gray-200">
          <div class="p-10">
            <div class="mb-6">
              <h3 class="text-3xl font-extrabold text-gray-900 mb-2">{brand.name} {brand.icon}</h3>
              <p class={`text-${brand.colors.gradient.split('-')[0]}-700 font-semibold`}>{brand.category}</p>
            </div>
            <p class="text-gray-700 mb-6 leading-relaxed">
              {brand.description}
            </p>
            <div class="flex flex-wrap gap-2 mb-6">
              {brand.products.map((product: string) => (
                <span class="px-4 py-2 bg-white rounded-full text-sm font-semibold text-gray-700 shadow-sm">
                  {product}
                </span>
              ))}
            </div>
            <a 
              href={brand.cta.href} 
              class={`inline-flex items-center gap-2 ${brand.id === 'chocizone' ? 'bg-chocizone-gradient' : brand.id === 'fihizu' ? 'bg-fihizu-gradient' : `bg-gradient-to-r from-${brand.colors.gradient} to-${brand.colors.gradientTo}`} text-white px-8 py-4 rounded-full font-bold hover:shadow-lg hover:-translate-y-1 transition-all shadow-md`}
            >
              {brand.cta.text}
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
          <div class={`absolute -right-20 -bottom-20 w-64 h-64 bg-${brand.colors.accent}/30 rounded-full blur-3xl group-hover:bg-${brand.colors.accent}/50 transition-colors`}></div>
        </div>
      ))}
    </div>
  </div>
</section>