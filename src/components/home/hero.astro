---
interface HeroImage {
  src: string;
  alt: string;
  title: string;
  description: string;
}

interface HeroFeature {
  icon: string;
  title: string;
  description: string;
}

interface HeroCTA {
  text: string;
  href: string;
  variant: string;
}

interface HeroSlider {
  intervalMs: number;
  aspect: string;
}

interface HeroData {
  id: string;
  title: string;
  subtitle: string;
  description: string;
  feature: HeroFeature;
  images: HeroImage[];
  slider: HeroSlider;
  ctas: HeroCTA[];
}

interface Props {
  data: HeroData;
}

const { data } = Astro.props as Props;
---

<section id={data.id} class="bg-gradient-to-br from-pink-100 via-purple-50 to-rose-100 flex flex-col justify-center relative overflow-hidden min-h-screen">
  <!-- Decorative circles - más coloridos y juveniles -->
  <div class="absolute top-[-20%] right-[-5%] w-[300px] md:w-[500px] lg:w-[700px] h-[300px] md:h-[500px] lg:h-[700px] bg-gradient-to-br from-pink-300/30 to-purple-300/30 rounded-full blur-3xl"></div>
  <div class="absolute bottom-[-20%] left-[-5%] w-[250px] md:w-[400px] lg:w-[600px] h-[250px] md:h-[400px] lg:h-[600px] bg-gradient-to-br from-rose-300/30 to-orange-300/30 rounded-full blur-3xl"></div>
  
  <!-- Floating elements decorativos -->
  <div class="absolute top-20 left-10 animate-bounce delay-1000">
    <span class="text-4xl">✨</span>
  </div>
  <div class="absolute top-32 right-20 animate-bounce delay-2000">
    <span class="text-3xl">💖</span>
  </div>
  <div class="absolute bottom-40 left-20 animate-bounce delay-3000">
    <span class="text-3xl">🌸</span>
  </div>
  
  <!-- Content Container -->
  <div class="max-w-7xl mx-auto px-4 md:px-6 lg:px-8 pt-28 md:pt-36 lg:pt-44 pb-8 md:pb-10 w-full relative z-10">
    <!-- Text Content -->
    <div class="text-center mb-6 md:mb-8 max-w-4xl mx-auto">
      <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold leading-tight mb-3 md:mb-4 bg-gradient-to-r from-pink-600 via-purple-600 to-rose-600 bg-clip-text text-transparent">
        {data.title}
      </h1>
      <p class="text-lg md:text-xl lg:text-2xl mb-3 md:mb-4 text-gray-700 font-medium">
        {data.subtitle}
      </p>
      <p class="text-base md:text-lg mb-4 md:mb-6 text-gray-600 leading-relaxed max-w-3xl mx-auto px-4 md:px-0">
        {data.description}
      </p>
    </div>

    <!-- Feature Card - más atractiva y juvenil -->
    <div class="bg-white/80 backdrop-blur-sm rounded-2xl md:rounded-3xl px-6 py-4 border-2 border-pink-200 max-w-md mx-auto mb-8 shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
      <div class="flex items-center gap-4">
        <span class="text-3xl animate-pulse">{data.feature.icon}</span>
        <div>
          <h3 class="text-gray-900 font-bold text-lg bg-gradient-to-r from-pink-600 to-purple-600 bg-clip-text text-transparent">{data.feature.title}</h3>
          <p class="text-gray-600 text-sm">{data.feature.description}</p>
        </div>
      </div>
    </div>

    <!-- Image Gallery - más moderna y atractiva -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
      {data.images.map((image: HeroImage, index: number) => (
        <div class={`group relative overflow-hidden rounded-3xl shadow-xl hover:shadow-2xl transition-all duration-500 hover:-translate-y-2 ${
          index === 0 ? 'border-4 border-pink-300' : 
          index === 1 ? 'border-4 border-purple-300' : 
          'border-4 border-rose-300'
        }`}>
          <img 
            src={image.src}
            alt={image.alt}
            class="w-full h-[280px] object-cover group-hover:scale-110 transition-transform duration-500"
          />
          <div class={`absolute inset-0 bg-gradient-to-t ${
            index === 0 ? 'from-pink-500/80 via-pink-500/20 to-transparent' : 
            index === 1 ? 'from-purple-500/80 via-purple-500/20 to-transparent' : 
            'from-rose-500/80 via-rose-500/20 to-transparent'
          } opacity-0 group-hover:opacity-100 transition-opacity duration-300`}></div>
          <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent p-4 transform translate-y-0 group-hover:-translate-y-1 transition-transform duration-300">
            <h3 class="text-white text-lg font-bold mb-1">{image.title}</h3>
            <p class="text-white/90 text-sm">{image.description}</p>
          </div>
          <!-- Decorative corner -->
          <div class={`absolute top-4 right-4 w-8 h-8 ${
            index === 0 ? 'bg-pink-400' : 
            index === 1 ? 'bg-purple-400' : 
            'bg-rose-400'
          } rounded-full flex items-center justify-center text-white font-bold text-sm`}>
            {index + 1}
          </div>
        </div>
      ))}
    </div>

    <!-- CTAs - más juveniles y atractivos -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center mb-8">
      {data.ctas.map((cta: HeroCTA, index: number) => (
        <a 
          href={cta.href}
          class={cta.variant === 'primary' 
            ? 'bg-gradient-to-r from-pink-500 to-rose-500 text-white px-10 py-4 rounded-full font-bold text-lg hover:from-pink-600 hover:to-rose-600 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 shadow-lg border-2 border-transparent hover:scale-105'
            : 'bg-white/90 backdrop-blur-sm text-gray-800 border-2 border-pink-300 px-10 py-4 rounded-full font-bold text-lg hover:bg-pink-50 hover:border-pink-400 hover:shadow-xl hover:-translate-y-1 transition-all duration-300'
          }
        >
          {cta.text}
        </a>
      ))}
    </div>

    <!-- Trust Badges - más coloridos y juveniles -->
    <div class="flex flex-wrap justify-center items-center gap-3 md:gap-4">
      <div class="bg-gradient-to-r from-pink-100 to-rose-100 backdrop-blur-sm rounded-full px-4 md:px-6 py-2 md:py-3 border-2 border-pink-200 shadow-sm hover:shadow-md transition-all">
        <p class="text-gray-700 font-bold text-xs md:text-sm">🌿 100% Natural</p>
      </div>
      <div class="bg-gradient-to-r from-purple-100 to-pink-100 backdrop-blur-sm rounded-full px-4 md:px-6 py-2 md:py-3 border-2 border-purple-200 shadow-sm hover:shadow-md transition-all">
        <p class="text-gray-700 font-bold text-xs md:text-sm">✓ Trazabilidad Total</p>
      </div>
      <div class="bg-gradient-to-r from-rose-100 to-orange-100 backdrop-blur-sm rounded-full px-4 md:px-6 py-2 md:py-3 border-2 border-rose-200 shadow-sm hover:shadow-md transition-all">
        <p class="text-gray-700 font-bold text-xs md:text-sm">🇨🇴 Origen Colombiano</p>
      </div>
      <div class="bg-gradient-to-r from-green-100 to-emerald-100 backdrop-blur-sm rounded-full px-4 md:px-6 py-2 md:py-3 border-2 border-green-200 shadow-sm hover:shadow-md transition-all">
        <p class="text-gray-700 font-bold text-xs md:text-sm">♻️ Eco-Friendly</p>
      </div>
    </div>
  </div>
</section>