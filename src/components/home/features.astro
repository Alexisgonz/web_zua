---
interface FeatureItem {
  id: string;
  icon: string;
  title: string;
  description: string;
  color: string;
}

interface Badge {
  icon: string;
  text: string;
}

interface Section {
  id: string;
  label: string;
  title: string;
  titleHighlight: string;
  description: string;
}

interface FeaturesData {
  section: Section;
  items: FeatureItem[];
  badges: Badge[];
}

interface Props {
  data: FeaturesData;
}

const { data } = Astro.props as Props;
const { section, items, badges } = data;

// Icon mapping
const iconMap: Record<string, string> = {
  sliders:
    "M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4",
  shield:
    "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
  zap: "M13 10V3L4 14h7v7l9-11h-7z",
};

const colorMap: Record<string, string> = {
  rose: "from-rose-400 to-rose-600 border-rose-100 hover:border-rose-300",
  emerald:
    "from-icon-green to-icon-green-dark border-icon-green/20 hover:border-icon-green/40",
  amber: "from-amber-400 to-amber-600 border-amber-100 hover:border-amber-300",
};
---

<section
  id={section.id}
  class="py-10 md:py-10 px-4 md:px-6 lg:px-8 bg-gradient-to-br from-gray-50 via-white to-gray-100"
>
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <h2
        class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-title-green mb-6"
      >
        {section.title}<br />
        <span
          class="text-transparent bg-clip-text bg-gradient-to-r from-title-green to-title-green-light"
          >{section.titleHighlight}</span
        >
      </h2>
      <p class="text-lg md:text-xl text-gray-600 max-w-3xl mx-auto">
        {section.description}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
      {
        items.map((item: FeatureItem) => {
          const itemColorClasses = colorMap[item.color];
          const gradientClass = itemColorClasses.split(" ")[0];
          
          return (
            <div
              class="group bg-white/90 backdrop-blur-sm rounded-3xl p-8 shadow-lg hover:shadow-2xl transition-all duration-300 border border-gray-200 hover:border-gray-300"
            >
              <div
                class={`w-16 h-16 bg-gradient-to-br ${gradientClass} rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform`}
              >
                <svg
                  class="w-8 h-8 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d={iconMap[item.icon]}
                  />
                </svg>
              </div>
              <h3 class="text-2xl font-bold text-gray-900 mb-4">{item.title}</h3>
              <p class="text-gray-600 leading-relaxed">{item.description}</p>
            </div>
          );
        })
      }
    </div>

    <div class="flex flex-wrap justify-center gap-4">
      {
        badges.map((badge: Badge) => (
          <div class="flex items-center gap-2 bg-white px-6 py-3 rounded-full shadow-md border border-gray-200">
            <span class="text-2xl">{badge.icon}</span>
            <span class="font-semibold text-gray-700">{badge.text}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>