---
interface BenefitItem {
  icon: string;
  title: string;
  description: string;
  color: string;
}

interface DecorativeIcon {
  emoji: string;
  position: string;
}

interface Section {
  id: string;
  label: string;
  title: string;
  titleHighlight: string;
  theme: string;
}

interface BenefitsData {
  section: Section;
  items: BenefitItem[];
  decorativeIcons: DecorativeIcon[];
}

interface Props {
  data: BenefitsData;
}

const { data } = Astro.props as Props;
const { section, items, decorativeIcons } = data;
---

<section class="py-20 md:py-32 px-4 md:px-6 lg:px-8 bg-icon-beige text-gray-900 relative overflow-hidden">
  <div class="absolute top-20 right-10 w-64 h-64 bg-white/20 rounded-full blur-3xl"></div>
  <div class="absolute bottom-20 left-10 w-96 h-96 bg-white/30 rounded-full blur-3xl"></div>

  <div class="max-w-7xl mx-auto relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div>
        <h2 class="text-4xl md:text-5xl font-extrabold mb-8 text-title-green">
          {section.title}<br/>
          <span class="text-title-green">{section.titleHighlight}</span>
        </h2>

        <div class="space-y-6">
          {items.map((item: BenefitItem) => (
            <div class="flex items-start gap-4 group">
              <div class={`w-12 h-12 bg-white/40 rounded-xl flex items-center justify-center shrink-0 group-hover:bg-white/60 transition-colors shadow-sm`}>
                <svg class={`w-6 h-6 text-gray-700`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-bold mb-2 text-gray-900">{item.title}</h3>
                <p class="text-gray-700">{item.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="relative">
        <div class="relative w-full aspect-square max-w-md mx-auto">
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-32 h-32 bg-gradient-to-br from-title-green to-title-green-dark rounded-full flex items-center justify-center shadow-2xl">
              <span class="text-4xl">🌿</span>
            </div>
          </div>
          {decorativeIcons.map((icon: DecorativeIcon, index: number) => (
            <div class={`absolute ${
              icon.position === 'top' ? 'top-0 left-1/2 -translate-x-1/2' :
              icon.position === 'bottom' ? 'bottom-0 left-1/2 -translate-x-1/2' :
              icon.position === 'left' ? 'left-0 top-1/2 -translate-y-1/2' :
              'right-0 top-1/2 -translate-y-1/2'
            } w-12 h-12 bg-white/40 rounded-full flex items-center justify-center backdrop-blur-sm border border-white/40 shadow-sm`}>
              <span class="text-2xl">{icon.emoji}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>