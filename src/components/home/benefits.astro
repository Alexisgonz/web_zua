---
interface BenefitItem {
  icon: string;
  title: string;
  description: string;
  color: string;
}

interface DecorativeIcon {
  emoji: string;
  position: string;
}

interface Section {
  id: string;
  label: string;
  title: string;
  titleHighlight: string;
  theme: string;
}

interface BenefitsData {
  section: Section;
  items: BenefitItem[];
  decorativeIcons: DecorativeIcon[];
}

interface Props {
  data: BenefitsData;
}

const { data } = Astro.props as Props;
const { section, items, decorativeIcons } = data;
---

<section class="py-20 md:py-32 px-4 md:px-6 lg:px-8 bg-title-green text-white relative overflow-hidden">
  <div class="absolute top-20 right-10 w-64 h-64 bg-white/10 rounded-full blur-3xl"></div>
  <div class="absolute bottom-20 left-10 w-96 h-96 bg-white/15 rounded-full blur-3xl"></div>

  <div class="max-w-7xl mx-auto relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div>
        <h2 class="text-4xl md:text-5xl font-extrabold mb-8 text-title-green">
          {section.title}<br/>
          <span class="text-title-green">{section.titleHighlight}</span>
        </h2>

        <div class="space-y-6">
          {items.map((item: BenefitItem) => (
            <div class="flex items-start gap-4 group">
              <div class="w-12 h-12 bg-white/20 rounded-xl flex items-center justify-center shrink-0 group-hover:bg-white/30 transition-colors shadow-sm">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-bold mb-2 text-white">{item.title}</h3>
                <p class="text-gray-200">{item.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="relative">
        <div class="relative w-full aspect-square max-w-lg mx-auto">
          {/* Centro principal con logo SUA */}
          <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-48 h-48 bg-gradient-to-br from-title-green to-title-green-dark rounded-full flex items-center justify-center shadow-2xl">
              <span class="text-6xl font-bold text-white tracking-wider">SUA</span>
            </div>
          </div>

          {/* Productos animados orbitando - Radio uniforme de 180px del centro */}
          <div class="absolute inset-0 animate-spin-slow transform-gpu will-change-transform">
            {/* Producto 1 - Top (0°) */}
            <div class="absolute top-[10px] left-1/2 -translate-x-1/2 transform-gpu will-change-transform animate-counter-spin">
              <div class="w-[100px] h-[100px] rounded-full overflow-hidden shadow-xl [backface-visibility:hidden]">
                <img src="/img/animacion_beneficios/7.png" width="100" height="100" alt="Producto SUA"
                     class="w-full h-full object-cover" loading="lazy" decoding="async" />
              </div>
            </div>

            {/* Producto 2 - Top Right (45°) */}
            <div class="absolute top-[38px] right-[38px] transform-gpu will-change-transform animate-counter-spin">
              <div class="w-[100px] h-[100px] rounded-full overflow-hidden shadow-xl bg-white [backface-visibility:hidden]">
                <img src="/img/animacion_beneficios/12.png" width="100" height="100" alt="Producto SUA"
                     class="w-full h-full object-contain p-2" loading="lazy" decoding="async" />
              </div>
            </div>

            {/* Producto 3 - Right (90°) */}
            <div class="absolute right-[10px] top-1/2 -translate-y-1/2 transform-gpu will-change-transform animate-counter-spin">
              <div class="w-[100px] h-[100px] rounded-full overflow-hidden shadow-xl [backface-visibility:hidden]">
                <img src="/img/animacion_beneficios/13.png" width="100" height="100" alt="Producto SUA"
                     class="w-full h-full object-cover" loading="lazy" decoding="async" />
              </div>
            </div>

            {/* Producto 4 - Bottom Right (135°) */}
            <div class="absolute bottom-[38px] right-[38px] transform-gpu will-change-transform animate-counter-spin">
              <div class="w-[100px] h-[100px] rounded-full overflow-hidden shadow-xl bg-white [backface-visibility:hidden]">
                <img src="/img/animacion_beneficios/15.png" width="100" height="100" alt="Producto SUA"
                     class="w-full h-full object-contain p-2" loading="lazy" decoding="async" />
              </div>
            </div>

            {/* Producto 5 - Bottom (180°) */}
            <div class="absolute bottom-[10px] left-1/2 -translate-x-1/2 transform-gpu will-change-transform animate-counter-spin">
              <div class="w-[100px] h-[100px] rounded-full overflow-hidden shadow-xl [backface-visibility:hidden]">
                <img src="/img/animacion_beneficios/24.png" width="100" height="100" alt="Producto SUA"
                     class="w-full h-full object-cover" loading="lazy" decoding="async" />
              </div>
            </div>

            {/* Producto 6 - Bottom Left (225°) */}
            <div class="absolute bottom-[38px] left-[38px] transform-gpu will-change-transform animate-counter-spin">
              <div class="w-[100px] h-[100px] rounded-full overflow-hidden shadow-xl bg-white [backface-visibility:hidden]">
                <img src="/img/animacion_beneficios/28.png" width="100" height="100" alt="Producto SUA"
                     class="w-full h-full object-contain p-2" loading="lazy" decoding="async" />
              </div>
            </div>

            {/* Producto 7 - Left (270°) */}
            <div class="absolute left-[10px] top-1/2 -translate-y-1/2 transform-gpu will-change-transform animate-counter-spin">
              <div class="w-[100px] h-[100px] rounded-full overflow-hidden shadow-xl bg-white [backface-visibility:hidden]">
                <img src="/img/animacion_beneficios/DSC_3442.jpg" width="100" height="100" alt="Producto SUA"
                     class="w-full h-full object-contain p-2" loading="lazy" decoding="async" />
              </div>
            </div>

            {/* Producto 8 - Top Left (315°) */}
            <div class="absolute top-[38px] left-[38px] transform-gpu will-change-transform animate-counter-spin">
              <div class="w-[100px] h-[100px] rounded-full overflow-hidden shadow-xl bg-white [backface-visibility:hidden]">
                <img src="/img/animacion_beneficios/DSC_3799.jpg" width="100" height="100" alt="Producto SUA"
                     class="w-full h-full object-contain p-2" loading="lazy" decoding="async" />
              </div>
            </div>
          </div>

          {/* Elementos decorativos flotantes */}
          <div class="absolute top-4 right-4 w-3 h-3 bg-white/60 rounded-full animate-pulse"></div>
          <div class="absolute bottom-12 left-12 w-2 h-2 bg-white/40 rounded-full animate-pulse delay-300"></div>
          <div class="absolute top-16 left-4 w-4 h-4 bg-white/50 rounded-full animate-pulse delay-700"></div>
        </div>
      </div>
    </div>
  </div>
</section>
