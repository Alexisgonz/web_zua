---
interface ValueMetric { value: string; label: string; }
interface ValueItem { id: string; icon: string; title: string; description: string; metric: ValueMetric; }
interface Section { id: string; title: string; subtitle: string; description: string; }
interface ValuesData { section: Section; values: ValueItem[]; }
interface Props { data: ValuesData; }
const { data } = Astro.props as Props;
---

<section
  id={data.section.id}
  class="relative py-8 md:py-18 px-4 md:px-6 lg:px-8
         bg-gradient-to-b from-gray-50 via-gray-100 to-gray-200 overflow-hidden"
>
  {/* decoraciones sutiles */}
  <div class="pointer-events-none absolute -top-10 -right-10 w-72 h-72 rounded-full bg-gray-400/20 blur-3xl"></div>
  <div class="pointer-events-none absolute -bottom-16 -left-10 w-72 h-72 rounded-full bg-gray-500/20 blur-3xl"></div>

  <div class="max-w-7xl mx-auto relative z-10">
    <div class="text-center mb-14">
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-title-green">
        {data.section.title}
      </h2>
      <p class="mt-4 text-lg md:text-xl text-gray-700">{data.section.subtitle}</p>
      <p class="mt-3 text-base md:text-lg text-gray-600 max-w-3xl mx-auto leading-relaxed">
        {data.section.description}
      </p>
    </div>

    {/* Grid de valores */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
      {data.values.map((value: ValueItem, i: number) => (
        <div class="group p-[1px] rounded-3xl bg-gradient-to-br
                    from-gray-400 via-gray-500 to-gray-600 hover:from-gray-500 hover:to-gray-700
                    transition-all duration-300">
          <div class="h-full bg-white/90 backdrop-blur-xl rounded-3xl p-7 md:p-8
                      shadow-lg hover:shadow-2xl transition-all duration-300
                      hover:-translate-y-1">
            {/* Icono */}
            <div class="w-16 h-16 md:w-18 md:h-18 rounded-full
                        bg-gradient-to-br from-icon-beige to-icon-beige-dark
                        text-white flex items-center justify-center text-3xl md:text-4xl
                        shadow-md group-hover:scale-105 transition-transform duration-300">
              {value.icon}
            </div>

            {/* Título & desc */}
            <h3 class="mt-5 text-2xl font-extrabold text-gray-900">
              {value.title}
            </h3>
            <p class="mt-3 text-gray-600 leading-relaxed">
              {value.description}
            </p>

            {/* Métrica tipo pill */}
            <div class="mt-6 pt-5 border-t border-gray-200">
              <div class="inline-flex items-center gap-2 rounded-full
                          bg-gradient-to-r from-gray-100 to-gray-200
                          border-2 border-gray-300 px-4 py-2 shadow-sm">
                <span class="text-lg md:text-xl font-extrabold text-title-green">
                  {value.metric.value}
                </span>
                <span class="text-xs md:text-sm text-gray-600">
                  {value.metric.label}
                </span>
              </div>
            </div>

            {/* Estrellitas decorativas */}
            <div class="mt-4 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
              <span class="text-gray-400">✨</span>
              <span class="text-title-green ml-1">✷</span>
              <span class="text-gray-500 ml-1">✿</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
/* micro animación opcional (si quieres más vida al hover) */
@keyframes float-soft { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-4px)} }
.group:hover .float-soft { animation: float-soft 3s ease-in-out infinite; }
</style>
