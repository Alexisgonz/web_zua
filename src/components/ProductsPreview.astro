---
import { getContentSection } from '../lib/cms'

const content = await getContentSection('products')
---

<section id={content.id} class="py-16 md:py-24 lg:py-32 px-4 md:px-6 lg:px-8 bg-gray-50">
  <div class="max-w-7xl mx-auto">
    <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-forest text-center mb-12 md:mb-16 lg:mb-20">
      {content.title}
    </h2>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-10 lg:gap-12">
      {content.businessLines.map((line: any) => (
        <div class="bg-white rounded-2xl md:rounded-3xl overflow-hidden shadow-lg hover:-translate-y-2 md:hover:-translate-y-3 hover:shadow-2xl transition-all duration-300">
          <div class="h-60 md:h-72 lg:h-80 relative overflow-hidden">
            <img 
              src={line.id === 'alimentaria' ? '/linea_alimenticia .png' : '/liea_cosmetica .png'}
              alt={`Imagen de ${line.title}`}
              class="w-full h-full object-cover"
            />
            <div class={`absolute inset-0 bg-gradient-to-br ${line.gradientFrom} ${line.gradientTo} opacity-20`}></div>
          </div>
          <div class="p-6 md:p-8 lg:p-10">
            <h3 class="text-2xl md:text-3xl font-extrabold text-forest mb-3 md:mb-4">
              {line.title}
            </h3>
            <p class="text-gray-600 text-base md:text-lg leading-relaxed mb-4 md:mb-6">
              {line.description}
            </p>
            <ul class="space-y-2 md:space-y-3 mb-6 md:mb-8">
              {line.products.map((product: any) => (
                <li class="text-gray-800 text-sm md:text-base font-semibold">
                  <span class="text-forest font-extrabold mr-2">✓</span> {product}
                </li>
              ))}
            </ul>
            <a
              href="#"
              class={`inline-block bg-forest text-white px-6 md:px-8 lg:px-10 py-3 md:py-4 rounded-full font-bold text-sm md:text-base lg:text-lg hover:-translate-y-1 hover:shadow-xl transition-all ${line.id === 'cosmetica' ? 'mt-6 md:mt-8 lg:mt-12' : ''}`}
            >
              {line.buttonText}
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
